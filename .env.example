# SatQuery Environment Variables

# Model Execution Mode (mock or real)
SATQUERY_MODEL_MODE=mock

# Run real model tests when set to 1
SATQUERY_RUN_MODEL_TESTS=0

# Model paths/IDs
SATQUERY_VQA_MODEL=MBZUAI/GeoChat-7B

# Optional cache directory for downloaded models
# SATQUERY_MODEL_CACHE=/path/to/cache
