# SatQuery Engine Environment Variables

# Model Execution Mode ('mock', 'real', or 'auto')
# - mock: Forces all heavy specialists to skip loading and use mock/baseline fallbacks (default).
# - real: Attempts to load all real ML weights.
# - auto: Attempts real models, falls back deterministically if unavailable.
SATQUERY_MODEL_MODE=mock

# Paths to Fine-Tuned Adapters/Weights
SATQUERY_VQA_ADAPTER=/path/to/lora/adapter
SATQUERY_CROMA_WEIGHTS=/path/to/croma/checkpoint.pt

# Base Model Overrides
SATQUERY_VQA_MODEL=MBZUAI/GeoChat-7B

# Run real model tests when set to 1
SATQUERY_RUN_MODEL_TESTS=0
